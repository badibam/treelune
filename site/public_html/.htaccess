# Every published asset is addressed with its content's digest (?v=, page.php asset()), so a
# browser may keep it a year; the page itself is asked again each time.
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|svg|ttf|webp|png|mp4)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.php$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
