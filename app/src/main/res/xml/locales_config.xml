<?xml version="1.0" encoding="utf-8"?>
<!-- The languages the app's texts are written in, which Android offers as the app's own language
     (Settings › Apps › Treelune › Language, Android 13 and later): English, the resources' default,
     and French, values-fr. Written by hand rather than generated by AGP, which would also list the
     languages of the libraries, dozens the app has no text in. A language added to the strings is
     added here too. -->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="fr" />
</locale-config>
