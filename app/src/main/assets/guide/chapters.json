{
  "_about": "The Guide's chapters (docs/design/user-journey.md), in their order: the journey first, then the reference. Their texts are strings of core/strings/sources/guide.xml, named after the chapter and the step (guide_<id>_title, guide_<id>_intro, guide_<id>_outro, guide_<id>_<n>_goal, guide_<id>_<n>_text). A step goes to a place (go), waits for an operation through the dispatcher (do), or is read (read, then Next, once at its place when it has one). A place's address may name what an earlier step kept: {zone}. A tool type's chapter is added in the tools' part from the tool's own strings. scripts/check_guide.py reads this file against the code.",
  "chapters": [
    {
      "id": "first_steps",
      "part": "discovery",
      "icon": "footprints",
      "minutes": 5,
      "steps": [
        {"kind": "go", "target": "zone/demo-course"},
        {"kind": "do", "target": "tool/demo-course-runs/demo-course",
          "await": {"operation": "tool_data.create", "origin": "USER", "params": {"tool_instance_id": "demo-course-runs"}}},
        {"kind": "read", "target": "tool/demo-course-chart-km/demo-course"},
        {"kind": "do", "target": "home",
          "await": {"operation": "zones.create", "origin": "USER"}, "keep": {"zone": "zone_id"}},
        {"kind": "do", "target": "zone/{zone}",
          "await": {"operation": "tools.create", "origin": "USER", "params": {"zone_id": "{zone}"}}, "keep": {"tool": "tool_instance_id"}},
        {"kind": "do", "target": "tool/{tool}/{zone}",
          "await": {"operation": "tool_data.create", "origin": "USER", "params": {"tool_instance_id": "{tool}"}}}
      ]
    },
    {
      "id": "connect_ai",
      "part": "discovery",
      "icon": "bot",
      "minutes": 5,
      "steps": [
        {"kind": "go", "target": "settings/ai_providers"},
        {"kind": "do", "target": "settings/ai_providers",
          "await": {"operation": "ai_provider_config.set", "origin": "USER"}},
        {"kind": "read"},
        {"kind": "read", "target": "chat"},
        {"kind": "read", "target": "chat"}
      ]
    },
    {
      "id": "build_with_ai",
      "part": "discovery",
      "icon": "hammer",
      "minutes": 10,
      "steps": [
        {"kind": "read"},
        {"kind": "do", "target": "chat",
          "await": {"operation": "tools.create", "origin": "AI"}, "keep": {"zone": "zone_id", "tool": "tool_instance_id"}},
        {"kind": "go", "target": "tool/{tool}/{zone}"},
        {"kind": "do", "target": "chat",
          "await": {"operation": "variables.create", "origin": "AI"}},
        {"kind": "read", "target": "settings/validation"}
      ]
    },
    {
      "id": "automate",
      "part": "discovery",
      "icon": "calendar-clock",
      "minutes": 12,
      "steps": [
        {"kind": "read"},
        {"kind": "do",
          "await": {"operation": "automations.create", "origin": "USER"}, "keep": {"automation": "automation_id", "zone": "zone_id"}},
        {"kind": "do", "target": "zone/{zone}",
          "await": {"operation": "automations.update", "origin": "USER", "params": {"automation_id": "{automation}"}}},
        {"kind": "do", "target": "zone/{zone}",
          "await": {"operation": "automations.execute_manual", "origin": "USER", "params": {"automation_id": "{automation}"}}},
        {"kind": "read", "target": "automation/{automation}/{zone}"},
        {"kind": "read", "target": "zone/{zone}"}
      ]
    },
    {
      "id": "configure_tool",
      "part": "getting_started",
      "icon": "settings",
      "minutes": 5,
      "steps": [
        {"kind": "read"},
        {"kind": "do",
          "await": {"operation": "tools.update", "origin": "USER"},
          "keep": {"tool": "tool_instance_id"}},
        {"kind": "do",
          "await": {"operation": "tool_data.create", "origin": "USER", "params": {"tool_instance_id": "{tool}"}}},
        {"kind": "read"}
      ]
    },
    {
      "id": "organize",
      "part": "getting_started",
      "icon": "layout-grid",
      "minutes": 6,
      "covers": ["home_config", "zone_config"],
      "steps": [
        {"kind": "read"},
        {"kind": "do", "target": "home_config",
          "await": {"operation": "app_config.set", "origin": "USER", "params": {"category": "main_screen"}}},
        {"kind": "do", "target": "home",
          "await": {"operation": "zones.update", "origin": "USER"}, "keep": {"zone": "zone_id"}},
        {"kind": "do", "target": "home",
          "await": {"operation": "zones.place", "origin": "USER"}},
        {"kind": "read", "target": "zone_config/{zone}"},
        {"kind": "read", "target": "zone/{zone}"}
      ]
    },
    {
      "id": "connect",
      "part": "getting_started",
      "icon": "link",
      "minutes": 8,
      "steps": [
        {"kind": "read"},
        {"kind": "do",
          "await": {"operation": "variables.create", "origin": "USER"}, "keep": {"zone": "zone_id"}},
        {"kind": "do", "target": "zone/{zone}",
          "await": {"operation": "variables.create", "origin": "USER"}},
        {"kind": "read", "target": "zone/{zone}"},
        {"kind": "read"}
      ]
    },
    {
      "id": "talk_to_ai",
      "part": "getting_started",
      "icon": "message-circle",
      "minutes": 8,
      "steps": [
        {"kind": "read", "target": "chat"},
        {"kind": "read", "target": "chat"},
        {"kind": "read", "target": "chat"},
        {"kind": "read", "target": "chat"},
        {"kind": "do", "target": "chat",
          "await": {"operation": "ai_sessions.update_validation", "origin": "USER"}},
        {"kind": "read", "target": "chat"}
      ]
    },
    {
      "id": "appearance",
      "part": "getting_started",
      "icon": "palette",
      "minutes": 3,
      "covers": ["ui_settings"],
      "steps": [
        {"kind": "do", "target": "settings/ui",
          "await": {"operation": "app_config.set", "origin": "USER", "params": {"category": "ui"}}},
        {"kind": "read", "target": "settings/ui"}
      ]
    },
    {
      "id": "your_data",
      "part": "getting_started",
      "icon": "database",
      "minutes": 3,
      "steps": [
        {"kind": "read", "target": "settings/data"},
        {"kind": "read", "target": "settings/data"}
      ]
    },
    {
      "id": "external_access",
      "part": "getting_started",
      "icon": "cable",
      "minutes": 6,
      "covers": ["external_access"],
      "steps": [
        {"kind": "read"},
        {"kind": "read", "target": "settings/external_access"},
        {"kind": "read", "target": "settings/external_access"},
        {"kind": "read", "target": "settings/external_access"}
      ]
    },
    {
      "id": "when_stuck",
      "part": "getting_started",
      "icon": "life-buoy",
      "minutes": 3,
      "steps": [
        {"kind": "read", "target": "settings/bug_report"},
        {"kind": "read"},
        {"kind": "read", "target": "settings/logs"}
      ]
    }
  ]
}
