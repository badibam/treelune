#!/usr/bin/env python3
"""Entry point for the Treelune development tasks.

Bare invocation opens the interactive menu; `./run <task>` runs one directly,
without requiring questionary.
"""

import os
import shutil
import subprocess
import sys
import time
from pathlib import Path
from xml.etree import ElementTree

ROOT = Path(__file__).resolve().parent
GRADLEW = ROOT / "gradlew"

# The two builds live side by side on a device, being two applications as far as Android
# is concerned, with separate databases. Which is the point of the suffix, and the reason
# anything that talks to "the app" has to say which one it means.
APPLICATION_ID = "app.treelune"
DEBUG_APPLICATION_ID = "app.treelune.debug"

# The release signing key, which lives outside the repository on purpose: a gitignored
# file at the root would still be swept away by `git clean -xdf`, and this one cannot be
# regenerated -- it is the app's identity to every phone that installed it.
SIGNING = Path.home() / ".config" / "treelune" / "signing.env"

# Where the published release is built: a fresh clone of its tag, outside the working tree,
# so that nothing the tag does not hold reaches the APK -- neither a file git ignores nor what
# earlier builds left in app/build. The APK then matches the one F-Droid rebuilds from the
# tag, which is what lets F-Droid publish it under our signature. On the home disk, as F-Droid
# builds on ext4.
RELEASE_CLONES = Path.home() / ".cache" / "treelune" / "release"

# What the compiler says that is worth reading: the errors, and the verdict.
BUILD_LINES = ("e:", "Error:", "ERROR:", "BUILD SUCCESSFUL", "BUILD FAILED")

# Where gradle leaves the machine-readable test results, and the report for a human.
TEST_RESULTS = ROOT / "app" / "build" / "test-results" / "testDebugUnitTest"
TEST_REPORT = ROOT / "app" / "build" / "reports" / "tests" / "testDebugUnitTest" / "index.html"

# The ratchet on the project's naming rule for keys. It runs with the tests rather than as a
# task of its own: a task one has to remember is exactly what the ratchet replaces.
KEY_CASE_CHECK = ROOT / "scripts" / "check_key_case.py"

# The same idea applied to the L1 prompt: it is the project's only interface contract that is
# neither compiled nor tested, so its examples are read against the code they describe.
PROMPT_CHECK = ROOT / "scripts" / "check_prompt_examples.py"

# And on the translations: a key missing from one locale falls back to another language on
# screen rather than failing, so nothing else in the build would ever mention it.
LOCALE_CHECK = ROOT / "scripts" / "check_string_locales.py"

# And on timezones: a date computed in the device's timezone rather than the app's is right
# until the user sets an override, so no test on a machine with the same zone would see it.
TIMEZONE_CHECK = ROOT / "scripts" / "check_timezone.py"

# And on days: a day or a week cut by hand at midnight, or from Monday, is right only for the
# user whose calendar says so, and a test run in the afternoon never sees it.
DAY_BOUNDS_CHECK = ROOT / "scripts" / "check_day_bounds.py"

# And on the keys themselves: a key the code asks for and nobody wrote shows as "[key]" on
# screen, and nothing else fails.
STRING_KEYS_CHECK = ROOT / "scripts" / "check_string_keys.py"

# And on the pixel font: the app's copy of Cartouche against the font project it comes from,
# where a glyph drawn after the copy would otherwise never reach the app.
FONT_COPY_CHECK = ROOT / "scripts" / "check_font_copy.py"

# A theme's palettes: the numbers the theme derives its colours from, set by eye on its bench,
# which writes them back; a theme's sound choice, written back by the sound bench; the themes'
# benches open from one page.
PALETTES = ROOT / "app" / "src" / "main" / "resources" / "app" / "treelune" / "themes"
THEME_SOURCES = ROOT / "app" / "src" / "main" / "java" / "app" / "treelune" / "themes"
THEME_BENCHES = ROOT / "app" / "src" / "main" / "java" / "app" / "treelune" / "themes" / "bench.html"
# The theme tracks mocked up on one page, and the notes that rank them, written back by that page.
THEME_TRACKS = ROOT / "docs" / "theme-tracks.html"
THEME_TRACK_NOTES = ROOT / "docs" / "theme-tracks.json"

# And on spaces: a space a screen writes in dp looks right in the default theme and falls
# between two cells in the retro one, so every space is named (UI.Space) and the theme sizes it.
SPACING_CHECK = ROOT / "scripts" / "check_spacing.py"

# And on the READMEs: their generated blocks (tools, providers, themes, version) say what the
# code says, and a tool added without running the generator would leave them wrong unseen.
README_CHECK = ROOT / "scripts" / "make_readme.py"

# And on the Guide: a tutorial waits for operations and sends the user to places, and an
# operation renamed would leave its step waiting forever, with nothing else to say so.
GUIDE_CHECK = ROOT / "scripts" / "check_guide.py"

# And on the chat's floating button: a screen it floats over that leaves it no room at its end
# hides its last line under it, which only a phone shows.
CHAT_SPACE_CHECK = ROOT / "scripts" / "check_chat_space.py"

# And on the Tailscale node's dependencies: the committed copy carries a fix to Tailscale that a
# copy refreshed by hand loses in silence, and only a phone would show the Funnel failing.
GO_VENDOR_CHECK = ROOT / "scripts" / "vendor_go.py"

# And on the history of writes: a covered table written past its one door escapes the history,
# and the undo that comes to that row later finds a row it never saw.
HISTORY_WRITES_CHECK = ROOT / "scripts" / "check_history_writes.py"

# And on the French address: the app's French texts say tu to the user, and a vous that slips
# back in shows on a French phone with nothing else to fail -- neither the compile nor the
# tests read the translations for register.
FRENCH_ADDRESS_CHECK = ROOT / "scripts" / "check_french_address.py"

# And on the themes' sounds: what a theme plays, its credits and its sound choice agree, and every
# sound comes from a source whose licence the app takes; a file swapped by hand would not say so.
THEME_SOUNDS = ROOT / "scripts" / "theme_sounds.py"


def gradle(*args):
    """Delegate to the wrapper, never to a system-wide gradle."""
    return subprocess.run([str(GRADLEW), *args], cwd=ROOT, check=False).returncode


def gradle_env(extra, *args):
    """Same, with the signing key's variables added to the environment."""
    return subprocess.run([str(GRADLEW), *args], cwd=ROOT, check=False,
                          env={**os.environ, **extra}).returncode


def gradle_filtered(*args):
    """Run gradle and print only the error lines and the verdict.

    Kotlin compilation output buries a type error under hundreds of task lines, and the
    one thing wanted from a type check is whether it passed and where it did not.
    """
    process = subprocess.Popen(
        [str(GRADLEW), *args], cwd=ROOT,
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
    )
    for line in process.stdout:
        if line.startswith(BUILD_LINES):
            print(line, end="")
    return process.wait()


def gradle_tests(*args):
    """Run gradle and print the compiler errors, the failing tests, and the verdict.

    The compile filter alone is not enough here: a failing test prints
    "SomeTest > someCase FAILED" and its exception, none of which starts with the prefixes
    a type error uses. Filtering on those alone would report BUILD FAILED without ever
    saying which test broke, which is the one thing wanted from a test run.
    """
    process = subprocess.Popen(
        [str(GRADLEW), *args], cwd=ROOT,
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
    )
    for line in process.stdout:
        if line.startswith(BUILD_LINES) or " FAILED" in line:
            print(line, end="")
    return process.wait()


def test_tally(not_before):
    """Return (tests, failures, errors, fresh) from gradle's JUnit XML, or None if absent.

    A green run prints BUILD SUCCESSFUL whether it ran two hundred tests or none at all --
    and it prints the same thing when gradle skips the task as up to date. Counting the
    cases turns the verdict into something that says what was actually checked.

    The results stay on disk from the run before, so a build that fails on its way to the
    tests -- a type error, a broken annotation processor -- would otherwise be reported with
    the last run's count beside its BUILD FAILED, which reads as a suite that passed. Hence
    `fresh`: whether anything was written since this run started. Results that are not are
    still worth reporting when the build succeeded, because gradle skipping the task as up
    to date is a legitimate pass -- neither the code nor the tests moved -- but the caller
    has to say so rather than present them as a run that just happened.
    """
    if not TEST_RESULTS.is_dir():
        return None
    reports = list(TEST_RESULTS.glob("*.xml"))
    if not reports:
        return None
    tests = failures = errors = 0
    for report in reports:
        root = ElementTree.parse(report).getroot()
        tests += int(root.get("tests", 0))
        failures += int(root.get("failures", 0))
        errors += int(root.get("errors", 0))
    fresh = any(r.stat().st_mtime >= not_before for r in reports)
    return tests, failures, errors, fresh


def attached_devices():
    """Return [(serial, state, model)] as adb reports them; model is empty when adb gives none."""
    probe = subprocess.run(
        ["adb", "devices", "-l"], capture_output=True, text=True, check=False
    )
    rows = []
    for line in probe.stdout.splitlines()[1:]:
        fields = line.split()
        if len(fields) >= 2:
            model = next((f.split(":", 1)[1] for f in fields[2:] if f.startswith("model:")), "")
            rows.append((fields[0], fields[1], model))
    return rows


def pick_device(ready):
    """Ask which of the [(serial, model)] ready devices to use; None when cancelled.

    The choice is put in ANDROID_SERIAL for the rest of the task, which gradle and adb both read.
    """
    labels = [f"{serial} — {model}" if model else serial for serial, model in ready]
    try:
        import questionary
        answer = questionary.select("Several devices are ready:", choices=labels).ask()
    except ImportError:
        print("Several devices are ready:")
        for i, label in enumerate(labels, 1):
            print(f"  {i}. {label}")
        try:
            typed = input("Number: ").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            return None
        answer = labels[int(typed) - 1] if typed.isdigit() and 1 <= int(typed) <= len(labels) else None
    if answer is None:
        return None
    serial = ready[labels.index(answer)][0]
    os.environ["ANDROID_SERIAL"] = serial
    print(f"Using {serial}; to keep it: export ANDROID_SERIAL={serial}")
    return serial


def ready_device():
    """Return the serial of the one usable device, or None after explaining why not.

    adb reports a phone that is plugged in but not paired as `unauthorized`, and gradle
    then claims there is no device at all. Diagnosing here turns a dead end into an
    instruction.
    """
    if shutil.which("adb") is None:
        print("adb not found in PATH.", file=sys.stderr)
        return None

    devices = attached_devices()
    ready = [(serial, model) for serial, state, model in devices if state == "device"]
    chosen = os.environ.get("ANDROID_SERIAL")
    if chosen and any(serial == chosen for serial, _ in ready):
        return chosen
    if len(ready) == 1:
        return ready[0][0]
    if len(ready) > 1:
        # A person at a terminal chooses; a script is told how to
        if sys.stdin.isatty():
            return pick_device(ready)
        print("Several devices are ready:", file=sys.stderr)
        for serial, model in ready:
            print(f"  {serial}  {model}", file=sys.stderr)
        print("Pick one with: export ANDROID_SERIAL=<serial>", file=sys.stderr)
        return None

    if not devices:
        print(
            "No device attached. Check that the cable carries data rather than power\n"
            "only, and that USB debugging is on in the developer options.",
            file=sys.stderr,
        )
        return None

    for serial, state, _ in devices:
        if state == "unauthorized":
            print(
                f"{serial} has not authorised this computer.\n"
                "Unlock the phone and accept the 'Allow USB debugging' prompt, ticking\n"
                "'Always allow from this computer'. If no prompt shows up, replug, or\n"
                "revoke the USB debugging authorisations in the developer options.",
                file=sys.stderr,
            )
        elif state == "offline":
            print(
                f"{serial} is offline. Replug it, or restart the bridge:\n"
                "  adb kill-server && adb start-server",
                file=sys.stderr,
            )
        else:
            print(f"{serial} is in state '{state}', not usable.", file=sys.stderr)
    return None


def launch(application_id):
    """Start the application that was just installed.

    A freshly installed package sits stopped and never launched, and a textual launcher is
    free to leave it out of its list until it has run once. Running it settles that, and
    puts it on screen besides.

    The activity is asked for rather than written down: it lives under the namespace while
    the package carries the build type's suffix, so the pair is not guessable from either.
    """
    probe = subprocess.run(
        ["adb", "shell", "cmd", "package", "resolve-activity", "--brief",
         "-c", "android.intent.category.LAUNCHER", application_id],
        capture_output=True, text=True, check=False,
    )
    component = probe.stdout.strip().splitlines()[-1].strip() if probe.stdout.strip() else ""
    if "/" not in component:
        print(f"{application_id} declares no launcher activity to start.", file=sys.stderr)
        return
    subprocess.run(["adb", "shell", "am", "start", "-n", component],
                   capture_output=True, check=False)


def running(application_id):
    """The pid of that application on the device, or None."""
    probe = subprocess.run(
        ["adb", "shell", "pidof", "-s", application_id],
        capture_output=True, text=True, check=False,
    )
    return probe.stdout.strip() or None


def task_compile():
    """Type-check the sources without building anything installable."""
    return gradle_filtered("compileDebugKotlin")


def key_case_check():
    """Report any key written in camelCase, and say whether the rule still holds.

    Returns the script's exit code, 0 when nothing new has appeared.
    """
    process = subprocess.run([sys.executable, str(KEY_CASE_CHECK)], cwd=ROOT)
    return process.returncode


def prompt_check():
    """Report any promise the L1 prompt makes that the code no longer keeps.

    Returns the script's exit code, 0 when the examples and the code agree.
    """
    process = subprocess.run([sys.executable, str(PROMPT_CHECK)], cwd=ROOT)
    return process.returncode


def locale_check():
    """Report any key a translation is missing, carries alone, or formats differently.

    Returns the script's exit code, 0 when every locale holds the same keys.
    """
    process = subprocess.run([sys.executable, str(LOCALE_CHECK)], cwd=ROOT)
    return process.returncode


def timezone_check():
    """Report any read of the device's timezone outside DateTimeConfig.getZoneId().

    Returns the script's exit code, 0 when every date goes through the app's timezone.
    """
    process = subprocess.run([sys.executable, str(TIMEZONE_CHECK)], cwd=ROOT)
    return process.returncode


def day_bounds_check():
    """Report any day or week bound made outside the user's calendar (TimeResolver, Periods).

    Returns the script's exit code, 0 when every day and week is cut by the user's calendar.
    """
    process = subprocess.run([sys.executable, str(DAY_BOUNDS_CHECK)], cwd=ROOT)
    return process.returncode


def string_keys_check():
    """Report any string key the code asks for that the resources do not hold.

    Returns the script's exit code, 0 when every key exists.
    """
    process = subprocess.run([sys.executable, str(STRING_KEYS_CHECK)], cwd=ROOT)
    return process.returncode


def font_copy_check():
    """Report any Cartouche file the app carries that differs from the font project's.

    Returns the script's exit code, 0 when the copy is byte for byte the latest.
    """
    process = subprocess.run([sys.executable, str(FONT_COPY_CHECK)], cwd=ROOT)
    return process.returncode


def spacing_check():
    """Report any space a screen writes in dp rather than naming it with UI.Space.

    Returns the script's exit code, 0 when every space is named.
    """
    process = subprocess.run([sys.executable, str(SPACING_CHECK)], cwd=ROOT)
    return process.returncode


def readme_check():
    """Report any generated block of the READMEs that the sources have outgrown.

    Returns the script's exit code, 0 when every block is up to date. It never writes a
    README: the generator is run by hand, and its result read before it is committed.
    """
    process = subprocess.run([sys.executable, str(README_CHECK), "--check"], cwd=ROOT)
    return process.returncode


def guide_check():
    """Report any operation, place or text the Guide's chapters name that the code lacks.

    Returns the script's exit code, 0 when the chapters agree with the code.
    """
    process = subprocess.run([sys.executable, str(GUIDE_CHECK)], cwd=ROOT)
    return process.returncode


def chat_space_check():
    """Report any screen the chat's button floats over that leaves it no room.

    Returns the script's exit code, 0 when every such screen does.
    """
    process = subprocess.run([sys.executable, str(CHAT_SPACE_CHECK)], cwd=ROOT)
    return process.returncode


def go_vendor_check():
    """Report a copy of the Go dependencies that lacks the fix the Tailscale node needs on Android.

    Returns the script's exit code, 0 when the committed copy carries it. Needs no Go.
    """
    process = subprocess.run([sys.executable, str(GO_VENDOR_CHECK), "--check"], cwd=ROOT)
    return process.returncode


def french_address_check():
    """Report a vous, votre or vos in the app's French texts, which address the user as tu.

    Returns the script's exit code, 0 when every French text says tu.
    """
    process = subprocess.run([sys.executable, str(FRENCH_ADDRESS_CHECK)], cwd=ROOT)
    return process.returncode


def history_writes_check():
    """Report a write to a table the history covers made past its one door (Writes).

    Returns the script's exit code, 0 when every such write goes through it.
    """
    process = subprocess.run([sys.executable, str(HISTORY_WRITES_CHECK)], cwd=ROOT)
    return process.returncode


def theme_sounds_check():
    """Report a theme whose sounds, credits and sound choice disagree.

    Returns the script's exit code, 0 when they agree.
    """
    process = subprocess.run([sys.executable, str(THEME_SOUNDS), "check"], cwd=ROOT)
    return process.returncode


def task_test():
    """Run the unit tests and say how many ran, after checking the naming rule.

    These are the JVM tests under app/src/test: pure decision logic -- the AI state
    machine, the schedule calculator, the field migration comparison -- with no device,
    no emulator and no database behind them. A run takes seconds, which is the point:
    each case here is a check that would otherwise mean installing the build on a phone
    and reproducing the situation by hand.

    The key-case, prompt, locale, timezone, day-bound, string-key, font-copy, spacing, README, Guide, chat-room, Go-vendor, French-address, theme-sound and history-write checks come first and cost a fraction of a second. They
    are not tests -- they read the sources rather than running them -- but they answer the
    same question: is this tree fit to commit.
    """
    key_case = key_case_check()
    prompt = prompt_check()
    locales = locale_check()
    timezones = timezone_check()
    day_bounds = day_bounds_check()
    string_keys = string_keys_check()
    font_copy = font_copy_check()
    spacing = spacing_check()
    readme = readme_check()
    guide = guide_check()
    chat_space = chat_space_check()
    go_vendor = go_vendor_check()
    french_address = french_address_check()
    theme_sounds = theme_sounds_check()
    history_writes = history_writes_check()
    # Noted before the run, so that results left by the run before cannot be read as this
    # one's. A filesystem timestamp can lag by a second, hence the margin.
    started = time.time() - 1
    code = gradle_tests("testDebugUnitTest")
    tally = test_tally(not_before=started)

    # Nothing written by this run: trustworthy only if the build got through, in which case
    # gradle skipped the task because nothing had changed. Otherwise there is no answer.
    if tally is None or (not tally[3] and code != 0):
        print("no results from this run -- it did not get as far as the tests")
        return code or key_case or prompt or locales or timezones or day_bounds or string_keys or font_copy or spacing or readme or guide or chat_space or go_vendor or french_address or theme_sounds or history_writes or 1

    tests, failures, errors, fresh = tally
    bad = failures + errors
    unchanged = "" if fresh else ", unchanged since the last run"
    print(f"{tests} tests, {bad} failed{unchanged}")
    if bad:
        print(f"report: {TEST_REPORT}")
    # The checks print first, and a green test count below them reads as a verdict. Say
    # again, last, that the tree is not fit to commit.
    failed_checks = sum(1 for c in (key_case, prompt, locales, timezones, day_bounds, string_keys, font_copy, spacing, readme, guide, chat_space, go_vendor, french_address, theme_sounds, history_writes) if c)
    if failed_checks:
        print(f"{failed_checks} source check(s) failed -- see above")
    return code or key_case or prompt or locales or timezones or day_bounds or string_keys or font_copy or spacing or readme or guide or chat_space or go_vendor or french_address or theme_sounds or history_writes


def task_strings():
    """Regenerate strings_generated.xml from the XML sources."""
    return gradle("generateStringResources")


def task_build():
    return gradle("assembleDebug")


def task_install():
    if ready_device() is None:
        return 1
    code = gradle("installDebug")
    if code == 0:
        launch(DEBUG_APPLICATION_ID)
    return code


def signing():
    """Read the signing key's environment, or None when there is none.

    Parsed rather than sourced: this only ever needs four `export NAME=value` lines, and
    handing a file to a shell to run is a much larger thing to allow than reading it.
    """
    if not SIGNING.is_file():
        return None
    values = {}
    for line in SIGNING.read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if not line.startswith("export "):
            continue
        name, _, value = line[len("export "):].partition("=")
        values[name.strip()] = value.strip().strip("'\"")
    return values


def signing_or_refuse():
    """The signing key's environment, or None after saying why there is none.

    A release is never built unsigned: Android installs no unsigned APK, so the file would
    be rejected by the phone much later, for no visible reason. F-Droid is the exception --
    it signs with its own key -- and does not go through here.
    """
    keys = signing()
    if keys is None:
        print(
            f"No signing key at {SIGNING}.\n"
            "Run scripts/generate_keystore.sh to create one, or restore it from your\n"
            "backup: this key is the app's identity to every phone that installed it,\n"
            "and no update installs over a differently signed one.",
            file=sys.stderr,
        )
    else:
        print(f"Signing with the key named by {SIGNING}.", flush=True)
    return keys


def verify_signature(apk):
    """The verdict counts: an APK that does not verify is one no phone will install."""
    return subprocess.run(["./verify_signature.sh", str(apk)],
                          cwd=ROOT / "scripts", check=False).returncode


def task_release():
    """Assemble the signed release from the working tree, to try it on a phone.

    What is published comes from `release-tag` instead: the working tree holds what the
    tag does not, and its APK differs from the one F-Droid rebuilds.
    """
    if task_provider_facts() != 0:
        return 1
    keys = signing_or_refuse()
    if keys is None:
        return 1
    code = gradle_env(keys, "assembleRelease")
    if code != 0:
        return code
    apk = release_apk()
    if apk is None:
        print("No release APK was produced.", file=sys.stderr)
        return 1
    return verify_signature(apk)


def task_release_tag(tag=None):
    """Assemble the signed release to publish, from a fresh clone of its tag.

    The tag defaults to the one on HEAD. The clone takes the tag from this repository, so
    it needs not be pushed; local.properties, which git does not hold, is copied in for the
    SDK and Go. The APK stays in the clone, whose path is printed.
    """
    if tag is None:
        described = subprocess.run(["git", "describe", "--exact-match", "--tags", "HEAD"],
                                   cwd=ROOT, capture_output=True, text=True, check=False)
        if described.returncode != 0:
            print("HEAD carries no tag: name the one to build (./run release-tag vX.Y.Z).",
                  file=sys.stderr)
            return 1
        tag = described.stdout.strip()
    properties = ROOT / "local.properties"
    if not properties.is_file():
        print(f"No {properties}: the clone needs it to find the SDK and Go.", file=sys.stderr)
        return 1
    if task_provider_facts() != 0:
        return 1
    keys = signing_or_refuse()
    if keys is None:
        return 1
    clone = RELEASE_CLONES / tag
    if clone.exists():
        shutil.rmtree(clone)
    clone.parent.mkdir(parents=True, exist_ok=True)
    cloned = subprocess.run(["git", "clone", "--quiet", "--branch", tag, str(ROOT), str(clone)],
                            check=False)
    if cloned.returncode != 0:
        return cloned.returncode
    shutil.copy2(properties, clone / "local.properties")
    print(f"Building {tag} in {clone}.", flush=True)
    # Through bash: the tags up to v0.8.0 were recorded with gradlew not executable.
    code = subprocess.run(["bash", str(clone / "gradlew"), "assembleRelease"], cwd=clone, check=False,
                          env={**os.environ, **keys}).returncode
    if code != 0:
        return code
    apk = release_apk(clone)
    if apk is None:
        print("No release APK was produced.", file=sys.stderr)
        return 1
    code = verify_signature(apk)
    if code == 0:
        print(f"Release APK: {apk}")
    return code


def release_apk(root=ROOT):
    """The release APK gradle just wrote under root, or None."""
    outputs = root / "app/build/outputs/apk/release"
    apks = sorted(outputs.glob("*.apk")) if outputs.is_dir() else []
    return apks[-1] if apks else None


def task_install_release():
    """Assemble the release and put it on the device.

    Not `installRelease`: going through adb keeps a refusal to install an ordinary answer
    from Android rather than a gradle task failing for its own reasons.
    """
    if ready_device() is None:
        return 1
    if task_release() != 0:
        return 1
    apk = release_apk()
    if apk is None:
        print("No release APK was produced.", file=sys.stderr)
        return 1
    subprocess.run(["adb", "install", "-r", str(apk)], check=False)
    launch(APPLICATION_ID)
    return 0


def task_logs(which=None):
    """Follow one build's log.

    logcat takes a single --pid, so with both builds installed -- the ordinary state of a
    device one tests releases on -- something has to choose. Whichever is running when
    only one is; the debug build when both are, that being the working loop.
    """
    if ready_device() is None:
        return 1
    ids = {"debug": DEBUG_APPLICATION_ID, "release": APPLICATION_ID}
    if which is not None and which not in ids:
        print(f"Unknown build: {which}. Say 'debug' or 'release'.", file=sys.stderr)
        return 1

    if which is None:
        up = {name: running(app) for name, app in ids.items()}
        up = {name: pid for name, pid in up.items() if pid}
        if not up:
            print("Neither build is running on the device.", file=sys.stderr)
            return 1
        which = "debug" if "debug" in up else "release"
        if len(up) > 1:
            other = "release" if which == "debug" else "debug"
            print(f"Both are running; following {which}. For the other: ./run logs {other}")

    pid = running(ids[which])
    if not pid:
        print(f"{ids[which]} is not running on the device.", file=sys.stderr)
        return 1
    return subprocess.run(["adb", "logcat", f"--pid={pid}"], check=False).returncode


def task_devices():
    if shutil.which("adb") is None:
        print("adb not found in PATH.", file=sys.stderr)
        return 1
    return subprocess.run(["adb", "devices", "-l"], check=False).returncode


def task_db():
    """Back up or restore the device database, for migration testing."""
    return subprocess.run(["./db_backup_restore.sh"], cwd=ROOT / "scripts",
                          check=False).returncode


# The project that keeps what AI providers change without their API saying so
# (`ia-service-distant`, "Faits fournisseurs"): retired models, traps, recalibrations.
FACTS_PROJECT = ROOT.parent / "provider-facts"


def task_provider_facts():
    """Check the app against the providers' facts: its copy of `facts.json`, and the models it names.

    A retired model the code still names fails, so does a trap left without a note in
    `provider-facts.json`. The check is that project's; it stays out of the Gradle build, which
    F-Droid runs without the neighbouring folder.
    """
    if not (FACTS_PROJECT / "run").is_file():
        print(f"{FACTS_PROJECT} is missing: the facts project is not where it is expected.", file=sys.stderr)
        return 1
    return subprocess.run([str(FACTS_PROJECT / "run"), "check", str(ROOT)], cwd=FACTS_PROJECT, check=False).returncode


def task_clean():
    return gradle("clean")


def task_bench(*args):
    """Free models played on the app's scenarios, on the emulator (docs/AI.md, « Free models and the bench »).

    Bare, it asks which models and levels and shows the cost before playing; with arguments,
    they go to scripts/bench.py as they are.
    """
    return subprocess.run([sys.executable, str(ROOT / "scripts" / "bench.py"), *args], cwd=ROOT,
                          check=False).returncode


def task_bugs():
    """Bring the bugs noted on the phone (Dev › Treelune) into TODO.md, then delete them there.

    Through the claude.ai connector to the app's MCP server: the phone's external access must be open.
    """
    return subprocess.run([sys.executable, str(ROOT / "scripts" / "phone_bugs.py")], cwd=ROOT,
                          check=False).returncode


def task_themes():
    """Serve the themes' benches and open their page; Ctrl+C stops the server."""
    return serve_themes(THEME_BENCHES)


def task_tracks():
    """Serve the theme tracks' page, where the user notes them, and open it; Ctrl+C stops the server."""
    return serve_themes(THEME_TRACKS)


def serve_themes(page):
    """Serve the repository for the themes' pages and open one of them.

    The benches read the fonts, Lucide's icons, a theme's palettes.json and the sound library from
    the repository, which a page opened from the disk may not do, and save back through here the
    only files of the repository this server writes: a theme's palettes.json (POST
    /palettes/<id>), its textures.json (POST /textures/<id>), the numbers of its icons' drawing
    (icons.json, POST /icons/<id>) and its sounds-choice.json (POST
    /sounds/<id>), for a theme whose folder exists; the tracks' page saves their notes (POST
    /tracks). The sound bench also has a sound finished as its unsaved choice says (POST
    /hear/<id>), written in the library under tmp/. Each file is
    replaced whole so that a save cut short leaves the old one.
    """
    import http.server
    import json
    import re

    def palettes(document):
        if not isinstance(document.get("palettes"), list):
            raise ValueError("no palettes list")

    def icons(document):
        if not document or not all(isinstance(v, (int, float)) for v in document.values()):
            raise ValueError("not a set of numbers")

    def textures(document):
        if not isinstance(document.get("modes"), dict):
            raise ValueError("no modes")

    def sounds(document):
        if not isinstance(document.get("signals"), dict) or not isinstance(document.get("families"), list):
            raise ValueError("no signals or families")

    def tracks(document):
        if not isinstance(document.get("tracks"), dict):
            raise ValueError("no tracks")

    # What a POST may write: its path's kind, the file it writes for a theme, and what its body must hold.
    SAVES = {
        "palettes": (lambda theme: PALETTES / theme / "palettes.json", palettes),
        "textures": (lambda theme: PALETTES / theme / "textures.json", textures),
        "icons": (lambda theme: PALETTES / theme / "icons.json", icons),
        "sounds": (lambda theme: THEME_SOURCES / theme / "sounds-choice.json", sounds),
    }

    class Bench(http.server.SimpleHTTPRequestHandler):
        def __init__(self, *args, **kwargs):
            super().__init__(*args, directory=str(ROOT), **kwargs)

        def do_POST(self):
            # Read whole first: a request answered before its body is read leaves the client writing into a closed socket.
            body = self.rfile.read(int(self.headers.get("Content-Length", 0))).decode("utf-8")
            hear = re.fullmatch(r"/hear/([a-z][a-z0-9_]*)", self.path)
            if hear:
                self.hear(hear.group(1), body)
                return
            if self.path == "/tracks":
                kind, target, valid = "tracks", THEME_TRACK_NOTES, tracks
            else:
                match = re.fullmatch(r"/(palettes|textures|icons|sounds)/([a-z][a-z0-9_]*)", self.path)
                if not match or not (THEME_SOURCES / match.group(2)).is_dir():
                    self.send_error(404)
                    return
                kind = match.group(1)
                target_of, valid = SAVES[kind]
                target = target_of(match.group(2))
            try:
                document = json.loads(body)
                valid(document)
            except ValueError as error:
                self.send_error(400, f"not a {kind} document: {error}")
                return
            target.parent.mkdir(parents=True, exist_ok=True)
            partial = target.with_suffix(".json.part")
            partial.write_text(json.dumps(document, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
            os.replace(partial, target)
            print(f"saved {target.relative_to(ROOT)}")
            self.send_response(204)
            self.end_headers()

        def hear(self, theme, body):
            """A sound finished as the sound bench's unsaved choice says, written in the library
            and named in the answer with its measures, the page playing it from there; writes
            nothing the repository keeps."""
            try:
                request = json.loads(body)
                with library_lock:
                    if not library:
                        library.update(theme_sounds.library_sounds())
                    out, info = theme_sounds.hear(theme, request["choice"], request["id"],
                                                  float(request.get("offset_db", 0)), library,
                                                  request.get("take"))
            except (ValueError, KeyError) as error:
                self.send_error(400, str(error))
                return
            answer = json.dumps({"file": out.relative_to(ROOT).as_posix(), **info}).encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(answer)))
            self.end_headers()
            self.wfile.write(answer)

        def log_message(self, format, *args):
            pass

    # The sound bench's finish (POST /hear/<id>) is scripts/theme_sounds.py's, never a copy.
    import importlib.util
    import threading
    spec = importlib.util.spec_from_file_location("theme_sounds", ROOT / "scripts" / "theme_sounds.py")
    theme_sounds = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(theme_sounds)
    library, library_lock = {}, threading.Lock()

    server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Bench)
    url = f"http://127.0.0.1:{server.server_port}/{page.relative_to(ROOT)}"
    print(f"{url}\nCtrl+C to stop.")
    subprocess.Popen(["xdg-open", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    try:
        server.serve_forever()
    finally:
        server.server_close()


ACTIONS = {
    "compile": task_compile,
    "test": task_test,
    "strings": task_strings,
    "build": task_build,
    "install": task_install,
    "logs": task_logs,
    "devices": task_devices,
    "release": task_release,
    "release-tag": task_release_tag,
    "install-release": task_install_release,
    "provider-facts": task_provider_facts,
    "db": task_db,
    "bench": task_bench,
    "bugs": task_bugs,
    "themes": task_themes,
    "tracks": task_tracks,
    "clean": task_clean,
}

LABELS = {
    "compile": "compile    type-check the sources, errors and verdict only",
    "test": "test       check the naming rule, then run the unit tests",
    "strings": "strings    regenerate the string resources",
    "build": "build      assemble the debug APK",
    "install": "install    assemble, install and start the debug build",
    "logs": "logs       follow logcat, filtered on the app",
    "devices": "devices    list attached devices and their state",
    "release": "release    assemble the signed release APK from the working tree, to try it",
    "release-tag": "release-tag       assemble the signed release to publish, from a clean clone of the tag on HEAD",
    "install-release": "install-release   assemble, install and start the release",
    "provider-facts": "provider-facts    check the app against the providers' facts (run by release)",
    "db": "db         back up or restore the device database",
    "bench": "bench      free models played on the app's scenarios, on the emulator",
    "bugs": "bugs       the bugs noted on the phone (Dev › Treelune) into TODO.md, then deleted there",
    "themes": "themes     the themes' benches: their colours, their palettes and their sounds set and saved",
    "tracks": "tracks     the theme tracks mocked up, noted and ranked in the order they will be made",
    "clean": "clean      drop build outputs",
}

_QUIT = object()


def interruptible(action, *args):
    """Run a task so that Ctrl+C stops it and nothing else.

    Ctrl+C is how `logs` is meant to end, and how any build is abandoned: it returns to the
    menu, or to the shell with the conventional status, rather than dumping a traceback.
    """
    try:
        return action(*args) or 0
    except KeyboardInterrupt:
        print()
        return 130


def pause():
    try:
        input("\nEnter to continue ")
    except (EOFError, KeyboardInterrupt):
        pass


def menu():
    try:
        import questionary
        from questionary import Choice, Separator
    except ImportError:
        print(
            "questionary is missing: sudo apt install python3-questionary\n"
            "Direct invocation still works: ./run <task>",
            file=sys.stderr,
        )
        return 1

    choices = [Separator("Build")]
    choices += [Choice(LABELS[k], k) for k in ("compile", "strings", "build", "install")]
    choices += [Separator("Device")]
    choices += [Choice(LABELS[k], k) for k in ("logs", "devices", "db", "bench", "bugs")]
    choices += [Separator("Release")]
    choices += [Choice(LABELS[k], k) for k in ("release", "install-release", "release-tag", "provider-facts")]
    choices += [Separator("Theme")]
    choices += [Choice(LABELS[k], k) for k in ("themes", "tracks")]
    choices += [Separator(""), Choice(LABELS["clean"], "clean")]
    choices += [Choice("quit", _QUIT)]

    while True:
        os.system("clear")
        answer = questionary.select("treelune", choices=choices).ask()
        if answer is None or answer is _QUIT:
            return 0
        interruptible(ACTIONS[answer])
        pause()


def usage():
    print("Usage: ./run [task]\n\nTasks:")
    for key in ACTIONS:
        print(f"  {LABELS[key]}")


def main(argv):
    if not argv:
        return menu()
    task = argv[0]
    if task in ("-h", "--help"):
        usage()
        return 0
    if task not in ACTIONS:
        print(f"Unknown task: {task}\n", file=sys.stderr)
        usage()
        return 1
    return interruptible(ACTIONS[task], *argv[1:])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
